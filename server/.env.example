PORT=5000
MONGO_URI=mongodb://localhost:27017/connectify

# IMPORTANT: Do NOT use the placeholder below as-is — the server will
# refuse to start with it (see server.js's startup safety check).
# Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Cloudflare Realtime TURN — used to relay voice/video calls between
# users on different networks (see DEPLOYMENT.md). Both are SECRET —
# never expose these to the frontend/browser. If left blank, calling
# still works but falls back to STUN-only, which won't reliably connect
# calls across different real-world networks.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
